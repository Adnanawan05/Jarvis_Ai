{
  "name": "jarvis-ai-desktop",
  "version": "2.0.0",
  "description": "J.A.R.V.I.S. - Just A Rather Very Intelligent System - Full Interactive Desktop AI Agent",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "jarvis",
    "ai",
    "desktop",
    "assistant",
    "automation",
    "voice-control"
  ],
  "author": "Malik Adnan",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.16.0"
  },
  "build": {
    "appId": "com.jarvis.ai",
    "productName": "JARVIS AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
